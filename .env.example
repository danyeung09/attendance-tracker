DB_PATH=./data.json
PORT=3000

# ─── Authentication (required in production) ──────────────────────────────────
# Everyone has their own account, created in the app. Anyone may register, but a
# new account starts as Pending and can see nothing until an admin gives it a
# role in Admin > Users.

# BREAK-GLASS ADMIN PASSWORD. Signs you in as an admin with no account at all,
# so losing every admin account is recoverable. This is the only password in the
# environment — everything else is a real user account. Keep it strong and use
# it rarely.
ADMIN_PASSWORD=change-this-admin-password

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=
